### running app, cloudflared ingress
docker compose --env-file .env -f deploy/docker-compose.yml config -q
docker ps --filter label=com.docker.compose.service=memex --format {{.Names}}
docker ps --filter name=^deploy-memex-1$ --format {{.Names}}
git describe --tags --match v[0-9]* --always --dirty
docker compose --env-file .env -f deploy/docker-compose.yml build memrain
docker compose --env-file .env -f deploy/docker-compose.yml config --services
docker compose --env-file .env -f deploy/docker-compose.yml stop cloudflared
docker compose --env-file .env -f deploy/docker-compose.yml ps --status running --services
docker inspect deploy-memrain-1 --format {{.State.Running}}
timeout 60 docker exec deploy-memrain-1 wget -qO- http://localhost:18790/health
docker exec deploy-memrain-1 wget -qO- http://localhost:18790/health
timeout 60 docker exec deploy-memrain-1 bun run src/cli.ts status
docker exec deploy-memrain-1 bun run src/cli.ts status
docker compose --env-file .env -f deploy/docker-compose.yml up -d --no-build --no-deps memrain
docker inspect deploy-memrain-1 --format {{.State.Health.Status}}
timeout 60 docker exec deploy-memrain-1 wget -qO- http://localhost:18790/health
docker exec deploy-memrain-1 wget -qO- http://localhost:18790/health
timeout 60 docker exec deploy-memrain-1 bun run src/cli.ts status
docker exec deploy-memrain-1 bun run src/cli.ts status
docker compose --env-file .env -f deploy/docker-compose.yml up -d --no-build
docker compose --env-file .env -f deploy/docker-compose.yml ps --status running --services
docker compose --env-file .env -f deploy/docker-compose.yml config --services
--- exit 0
==> building memrain stamped v1.0.0
==> stopping the ingress (cloudflared) until the new app passes its gates
==> waiting for deploy-memrain-1 to report healthy (max 180s)
OK: deploy-memrain-1 healthy, serving v1.0.0, db=postgres, pages=100, ingress up
