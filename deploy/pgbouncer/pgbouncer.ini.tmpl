; Rendered by render.sh at container start. One pooler per tenant, on that
; tenant's network only, in front of that tenant's database only. The control
; database is never listed here: control connections identify the tenant by
; session_user and always go to the database directly.

[databases]
@DATABASES@

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir =
pidfile =
logfile =

auth_type = scram-sha-256
auth_file = @AUTH_FILE@

; Transaction mode: a server session belongs to a client for one transaction.
; The engine sends no session startup parameter (MEMRAIN_PG_POOLER), keeps
; locks and settings transaction-scoped (scope-lint), and its tenant role
; carries the timeouts. Protocol-level prepared statements are tracked
; (needs 1.21+).
pool_mode = transaction
max_prepared_statements = 200
default_pool_size = @DEFAULT_POOL_SIZE@
max_client_conn = 100

; postgres-js sends none of these; a psql or JDBC client may.
ignore_startup_parameters = extra_float_digits

; The client hop stays on the tenant's own Docker network.
client_tls_sslmode = disable
server_tls_sslmode = @SERVER_TLS_SSLMODE@

admin_users =
stats_users =
