{
  "name": "memrain",
  "version": "0.1.0",
  "description": "Memrain personal-knowledge brain — vector + keyword search over your markdown notes and ingested data, with Bedrock Titan embeddings.",
  "type": "module",
  "private": true,
  "bin": {
    "memrain": "./src/cli.ts",
    "memex": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "test": "bun test",
    "test:sharded": "bash scripts/test-sharded.sh",
    "test:changed": "CHANGED=origin/main bash scripts/test-sharded.sh",
    "bench": "bun run src/cli.ts bench",
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --no-warn-ignored",
    "lint:fix": "eslint src --no-warn-ignored --fix"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "@aws-sdk/client-secrets-manager": "^3.658.0",
    "@electric-sql/pglite": "^0.2.17",
    "chokidar": "5.0.0",
    "postgres": "3.4.9",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/bun": "1.3.13",
    "eslint": "10.8.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-python": "0.23.6",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "postgres@3.4.9": "patches/postgres@3.4.9.patch"
  }
}
