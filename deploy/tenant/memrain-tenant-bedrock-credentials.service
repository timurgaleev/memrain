[Unit]
Description=Memrain hosting: rewrite each tenant's Bedrock credentials before they expire
Documentation=file:///opt/memrain/docs/HOSTING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/memrain
ExecStart=/usr/bin/bash /opt/memrain/deploy/tenant/bedrock-credentials.sh
TimeoutStartSec=600
